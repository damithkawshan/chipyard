#!/usr/bin/expect --
#
# run_benchmarks_session.exp - Full pipeline for FPGA benchmark evaluation.
#
# Steps:
#   1. Program FPGA bitstream via Vivado
#   2. Boot Linux on VCU118, wait for shell
#   3. Mount SD card, copy sbc_read and other tools
#   4. Transfer PARSEC/SPLASH2 benchmark binaries (bodytrack, barnes, lu) via zmodem
#   5. Run each benchmark with migration OFF (baseline) then migration ON (SBC active)
#   6. Collect all L2/memory performance counters and report secondary_hits
#
# Usage:
#   ./run_benchmarks_session.exp
#   ./run_benchmarks_session.exp -bit /path/to/bitfile.bit
#   ./run_benchmarks_session.exp -noprog         # skip FPGA programming (already loaded)
#   ./run_benchmarks_session.exp -skippush        # skip file transfers (already on board)
#   ./run_benchmarks_session.exp -interact        # stay in picocom after completion
#   ./run_benchmarks_session.exp -tmo 3600        # workload timeout in seconds
#

# ──────────────────────────────────────────────────────────────────────────────
# Configuration
# ──────────────────────────────────────────────────────────────────────────────
set CY          "/home/damith/Research/repos/chipyard_performance_eval/chipyard"
set SCRIPTS     "$CY/scripts/ssbc_scripts"
set SW_DIR      "$CY/generators/rocket-chip-inclusive-cache/sw"
set STAGED      "$CY/software/parsec-benchmark/staged"
set DEFAULT_BIT "$CY/fpga/bitstream_storage/FPGADualRocketVCU118L18K1024K8WL2ConfigSBCPLRU-dual-1MB-8way-2026-09-30.bit"

set DEVICE      "/dev/ttyUSB2"
set BAUD        "115200"
set SEND_CMD    "sz -vv -b -w 1024 -L 128"
set RECV_CMD    "rz -vv -b -E"
set LOGIN       "root"
set PASSWORD    "fpga"
set PROMPT      "# "
set BOOT_TMO    1800
set WORK_TMO    1800
set SETUP_TMO   3600

set send_slow   {1 .008}

# Defaults
set BIT          $DEFAULT_BIT
set DO_PROG      1
set SKIP_PUSH    0
set DO_INTERACT  0
set NTHREADS     2

# Benchmarks to run: bodytrack, barnes, lu
# Each entry is: {name binary_basename run_cmd needs_input_files}
set BENCH_LIST [list \
    {bodytrack  bodytrack    "./bodytrack sequenceB_1 4 1 5 1 0 $NTHREADS" 1} \
    {barnes     barnes      "./barnes < barnes_input"   1} \
    {lu         lu          "./lu -p$NTHREADS -n256"    0} \
]

# ──────────────────────────────────────────────────────────────────────────────
# Parse command line
# ──────────────────────────────────────────────────────────────────────────────
for {set i 0} {$i < $argc} {incr i} {
    set a [lindex $argv $i]
    switch -- $a {
        "-bit"       { incr i; set BIT [lindex $argv $i] }
        "-noprog"    { set DO_PROG 0 }
        "-skippush"  { set SKIP_PUSH 1 }
        "-interact"  { set DO_INTERACT 1 }
        "-tmo"       { incr i; set WORK_TMO [lindex $argv $i] }
        "-threads"   { incr i; set NTHREADS [lindex $argv $i] }
        default      { puts "unknown arg: $a"; exit 2 }
    }
}

# ──────────────────────────────────────────────────────────────────────────────
# Log setup
# ──────────────────────────────────────────────────────────────────────────────
set stamp [clock format [clock seconds] -format "%Y%m%d-%H%M%S"]
set LOGDIR "$SCRIPTS/../logs"
catch { file mkdir $LOGDIR }
set LOGPATH "$LOGDIR/benchmark_session_$stamp.log"
log_file -a $LOGPATH

puts "\n=================================================================="
puts "===== FULL BENCHMARK EVALUATION SESSION"
puts "=================================================================="
puts "===== bitstream      : $BIT"
puts "===== program FPGA   : [expr {$DO_PROG ? {yes (Vivado)} : {no (-noprog)}}]"
puts "===== skip push      : [expr {$SKIP_PUSH ? {yes} : {no}}]"
puts "===== serial device  : $DEVICE @ $BAUD"
puts "===== benchmarks     : bodytrack, barnes, lu (threads: $NTHREADS)"
puts "===== workload timeout: ${WORK_TMO}s"
puts "===== log            : $LOGPATH"
puts "==================================================================\n"

# ──────────────────────────────────────────────────────────────────────────────
# Helpers
# ──────────────────────────────────────────────────────────────────────────────
proc board_cmd {cmd {tmo 60}} {
    global PROMPT
    set timeout $tmo
    send -s "$cmd\r"
    set probe [string range $cmd 0 59]
    expect {
        -ex $probe { return 1 }
        timeout {
            puts "\n!!! echo mismatch / timeout sending: $cmd"
            return 0
        }
    }
}

proc bail {msg} {
    global LOGPATH
    puts "\n!!! $msg"
    puts "!!! transcript: $LOGPATH"
    send "\x01\x18"
    expect eof
    exit 1
}

proc zmodem_send {filepath} {
    global PROMPT
    set base [file tail $filepath]
    set hsize [file size $filepath]
    puts "\n----- transferring $base ($hsize bytes) ..."

    set timeout 60
    if {![board_cmd "rm -f $base $base.\[0-9\]*"]} { bail "failed to clean old $base" }
    expect -re "$PROMPT"

    set timeout 30
    if {![board_cmd "rz -vv -b -E" 30]} { bail "failed to launch rz on board for $base" }
    expect {
        -re "rz waiting|\\*\\*B0|ZMODEM" { }
        timeout { puts "(waiting for rz...)" }
    }

    send "\x01\x13"
    expect {
        -re "file:" { send -s "$filepath\r" }
        timeout     { bail "picocom never prompted for file name ($base)" }
    }

    set timeout 900
    expect {
        -re "exit status: 0"       { puts "\n===== $base transferred successfully." }
        -re "exit status: \[1-9\]" { bail "sz failed for $base" }
        timeout                    { bail "transfer timed out for $base" }
    }

    set timeout 60
    expect -re "$PROMPT"
    if {![board_cmd "chmod +x $base"]} { bail "failed chmod $base" }
    expect -re "$PROMPT"

    # Verify file size
    if {![board_cmd "wc -c < $base"]} { bail "failed wc -c $base" }
    expect {
        -re "(\[0-9\]+)" {
            set bsize $expect_out(1,string)
            if {$bsize == $hsize} {
                puts "      verified size: $bsize bytes matches host"
            } else {
                puts "      (read size $bsize, expected $hsize)"
            }
        }
        timeout { puts "      (warning: could not verify size)" }
    }
    expect -re "$PROMPT"
}

# Accumulate results for final report
set results [list]

proc run_benchmark_phase {name cmd mig_state} {
    global PROMPT WORK_TMO results
    puts "\n=================================================================="
    puts "===== RUNNING $name  \[migrate=$mig_state\]"
    puts "=================================================================="

    set full_cmd "/root/sbc_read --migrate=$mig_state --zero -- sh -c '$cmd 2> wl.err' ; echo \"workload rc=\$?\" ; tail -5 wl.err"
    puts "----- command: $full_cmd"

    if {![board_cmd "$full_cmd"]} {
        puts "!!! Failed to send command for $name"
        lappend results [list $name $mig_state "SEND_FAIL" "" ""]
        return 0
    }

    set timeout $WORK_TMO
    set sbc_line ""
    set sec_hits "?"
    set workload_rc "?"
    expect {
        -re {\[SBC-WINDOW\][^\r\n]*} {
            set sbc_line $expect_out(0,string)
            puts "\n===== \[SBC-WINDOW\]: $sbc_line"
            if {[regexp {secHits=(\d+)} $sbc_line -> sh]} {
                set sec_hits $sh
            }
            exp_continue
        }
        -re "secondary hits *: *(\\d+)" {
            set sec_hits $expect_out(1,string)
            exp_continue
        }
        -re "workload rc=(\\d+)" {
            set workload_rc $expect_out(1,string)
            puts "===== Workload finished with return code $workload_rc"
            exp_continue
        }
        -re "$PROMPT" {
            puts "===== Benchmark phase finished."
        }
        timeout {
            puts "\n!!! workload timed out after ${WORK_TMO}s"
            lappend results [list $name $mig_state "TIMEOUT" "" ""]
            return 0
        }
    }

    lappend results [list $name $mig_state "OK (rc=$workload_rc)" $sec_hits $sbc_line]
    return 1
}

# ──────────────────────────────────────────────────────────────────────────────
# STEP 1: Program FPGA
# ──────────────────────────────────────────────────────────────────────────────
if {$DO_PROG} {
    if {![file exists $BIT]} {
        puts "ERROR: Missing bitstream: $BIT"
        exit 1
    }
    puts "===== \[1/5\] Killing any serial processes before FPGA programming ..."
    catch { exec pkill -f "picocom.*ttyUSB" }
    catch { exec pkill -f "screen.*ttyUSB" }
    sleep 1

    puts "===== \[1/5\] Programming FPGA with Vivado (may take a few minutes) ..."
    set timeout 900
    spawn bash "$SCRIPTS/programFPGA.sh" $BIT
    expect {
        "FPGA programming complete!"  { puts "\n===== FPGA programmed successfully." }
        "ERROR"                       { puts "\n!!! Vivado error programming FPGA"; exit 1 }
        timeout                       { puts "\n!!! Vivado programming timed out"; exit 1 }
        eof                           { puts "\n!!! programFPGA.sh exited"; }
    }
    catch { expect eof }
} else {
    puts "===== \[1/5\] Skipping FPGA programming (-noprog)"
}

# ──────────────────────────────────────────────────────────────────────────────
# STEP 2: Open serial console
# ──────────────────────────────────────────────────────────────────────────────
puts "===== \[2/5\] Opening serial console ($DEVICE) ..."
set timeout 60
if {![file exists $DEVICE]} {
    puts "\n!!! $DEVICE not found. Waiting up to 15s for device to appear..."
    for {set retries 0} {$retries < 15} {incr retries} {
        sleep 1
        if {[file exists $DEVICE]} { break }
    }
    if {![file exists $DEVICE]} {
        puts "\n!!! $DEVICE still not present. Check FPGA connection."
        exit 1
    }
}

catch { exec pkill -f "picocom.*ttyUSB" }
sleep 1

spawn picocom -b $BAUD --send-cmd $SEND_CMD --receive-cmd $RECV_CMD $DEVICE
expect {
    "Terminal ready" { puts "\n===== picocom ready." }
    -re "cannot open|Device or resource busy|No such file" {
        puts "\n!!! picocom could not open $DEVICE"; exit 1
    }
    timeout { puts "\n!!! picocom never became ready"; exit 1 }
}

# ──────────────────────────────────────────────────────────────────────────────
# STEP 3: Wait for Linux boot & login
# ──────────────────────────────────────────────────────────────────────────────
puts "===== \[3/5\] Waiting for Linux to boot ..."
set timeout $BOOT_TMO
send "\r"
expect {
    -re "Welcome to Buildroot" {
        puts "\n===== Buildroot banner detected."
        exp_continue
    }
    -re "login:"        { send -s "$LOGIN\r"; exp_continue }
    -re "Password:"     { send -s "$PASSWORD\r"; exp_continue }
    -re "\n$PROMPT"     { puts "\n===== Shell prompt ready." }
    -re "^$PROMPT"      { puts "\n===== Shell prompt ready." }
    -re {\[ *[0-9]+\.[0-9]+\]}          { exp_continue }
    -re "INIT|CMD|LOADING|BOOT"          { exp_continue }
    -re "Linux version|Starting"         { exp_continue }
    -re "Kernel panic|Oops:|Unable to mount" {
        puts "\n!!! Kernel panic / boot failure"; exit 1
    }
    timeout {
        puts "\n!!! Timeout (${BOOT_TMO}s) waiting for Linux boot."
        exit 1
    }
}

# Ensure terminal is sane
if {![board_cmd "stty sane 2>/dev/null || true"]} { bail "failed stty sane" }
expect -re "$PROMPT"
if {![board_cmd "cd /root"]} { bail "failed cd /root" }
expect -re "$PROMPT"

# ──────────────────────────────────────────────────────────────────────────────
# STEP 4a: Mount SD card and transfer SBC tools
# ──────────────────────────────────────────────────────────────────────────────
puts "\n===== \[4/5\] Mount SD, transfer tools + benchmark binaries ..."

board_cmd "mkdir -p /mnt && if ! grep -q ' /mnt ' /proc/mounts; then if test -b /dev/mmcblk0p2; then mount /dev/mmcblk0p2 /mnt; elif test -b /dev/mmcblk0p1; then mount /dev/mmcblk0p1 /mnt; else mount /dev/mmcblk0 /mnt 2>/dev/null || true; fi; fi"
expect -re "$PROMPT"

board_cmd "mkdir -p /root/parsec"
expect -re "$PROMPT"

if {!$SKIP_PUSH} {
    # Check if sbc_read is executable
    board_cmd {test -x /root/sbc_read ; echo check_sbc=$?}
    expect {
        -re "check_sbc=0" {
            puts "\n===== sbc_read already present in /root/."
            expect -re "$PROMPT"
        }
        -re "check_sbc=1" {
            expect -re "$PROMPT"
            # Try restore from /mnt first
            board_cmd "test -x /mnt/sbc_read && cp /mnt/sbc_read /root/ && chmod +x /root/sbc_read || true"
            expect -re "$PROMPT"
            board_cmd {test -x /root/sbc_read ; echo check_sbc_mnt=$?}
            expect {
                -re "check_sbc_mnt=0" {
                    puts "\n===== sbc_read restored from /mnt/"
                    expect -re "$PROMPT"
                }
                -re "check_sbc_mnt=1" {
                    expect -re "$PROMPT"
                    puts "\n===== Pushing sbc_read to /root/ via ZMODEM ..."
                    zmodem_send "$SW_DIR/build/sbc_read"
                    board_cmd "chmod +x /root/sbc_read"
                    expect -re "$PROMPT"
                    board_cmd "cp /root/sbc_read /mnt/ 2>/dev/null || true"
                    expect -re "$PROMPT"
                }
            }
        }
    }

    # Transfer benchmark binaries into /root/parsec/
    board_cmd "cd /root/parsec"
    expect -re "$PROMPT"

    # 1. bodytrack + sequenceB_1
    board_cmd {test -x /root/parsec/bodytrack && test -d /root/parsec/sequenceB_1 ; echo check_bt=$?}
    expect {
        -re "check_bt=0" {
            puts "\n===== bodytrack and inputs already present."
            expect -re "$PROMPT"
        }
        -re "check_bt=1" {
            expect -re "$PROMPT"
            board_cmd "if test -d /mnt/parsec && test -x /mnt/parsec/bodytrack && test -d /mnt/parsec/sequenceB_1; then cp -r /mnt/parsec/bodytrack /mnt/parsec/sequenceB_1 /root/parsec/ ; fi"
            expect -re "$PROMPT"
            board_cmd {test -x /root/parsec/bodytrack ; echo check_bt_mnt=$?}
            expect {
                -re "check_bt_mnt=0" {
                    puts "\n===== bodytrack restored from /mnt/parsec/"
                    expect -re "$PROMPT"
                }
                -re "check_bt_mnt=1" {
                    expect -re "$PROMPT"
                    puts "\n===== Pushing bodytrack and sequenceB_1 via ZMODEM ..."
                    zmodem_send "$STAGED/bodytrack"
                    zmodem_send "$STAGED/sequenceB_1.tar.gz"
                    board_cmd "tar -xzf sequenceB_1.tar.gz"
                    expect -re "$PROMPT"
                }
            }
        }
    }

    # 2. lu
    board_cmd {test -x /root/parsec/lu ; echo check_lu=$?}
    expect {
        -re "check_lu=0" {
            puts "\n===== lu already present."
            expect -re "$PROMPT"
        }
        -re "check_lu=1" {
            expect -re "$PROMPT"
            board_cmd "test -x /mnt/parsec/lu && cp /mnt/parsec/lu /root/parsec/ || true"
            expect -re "$PROMPT"
            board_cmd {test -x /root/parsec/lu ; echo check_lu_mnt=$?}
            expect {
                -re "check_lu_mnt=0" {
                    puts "\n===== lu restored from /mnt/parsec/"
                    expect -re "$PROMPT"
                }
                -re "check_lu_mnt=1" {
                    expect -re "$PROMPT"
                    zmodem_send "$STAGED/lu"
                }
            }
        }
    }

    # 3. barnes + barnes_input
    board_cmd {test -x /root/parsec/barnes && test -f /root/parsec/barnes_input ; echo check_ba=$?}
    expect {
        -re "check_ba=0" {
            puts "\n===== barnes already present."
            expect -re "$PROMPT"
        }
        -re "check_ba=1" {
            expect -re "$PROMPT"
            board_cmd "if test -x /mnt/parsec/barnes && test -f /mnt/parsec/barnes_input; then cp /mnt/parsec/barnes /mnt/parsec/barnes_input /root/parsec/ ; fi"
            expect -re "$PROMPT"
            board_cmd {test -x /root/parsec/barnes ; echo check_ba_mnt=$?}
            expect {
                -re "check_ba_mnt=0" {
                    puts "\n===== barnes restored from /mnt/parsec/"
                    expect -re "$PROMPT"
                }
                -re "check_ba_mnt=1" {
                    expect -re "$PROMPT"
                    zmodem_send "$STAGED/barnes"
                    zmodem_send "$STAGED/barnes_input"
                }
            }
        }
    }

    # Make all executable and backup to /mnt/parsec
    board_cmd "chmod +x /root/parsec/bodytrack /root/parsec/lu /root/parsec/barnes /root/sbc_read 2>/dev/null || true"
    expect -re "$PROMPT"
    board_cmd "mkdir -p /mnt/parsec && cp -r /root/parsec/* /mnt/parsec/ 2>/dev/null || true"
    expect -re "$PROMPT"

    board_cmd "cd /root"
    expect -re "$PROMPT"

} else {
    puts "\n===== \[4/5\] Skipping file push (-skippush)"
}

# Verify SBC hardware status
puts "\n===== Verifying SBC hardware ..."
if {![board_cmd "/root/sbc_read"]} { bail "failed to run /root/sbc_read" }
set sbc_built -1
set found_policy "unknown"
expect {
    -re {migrate *: *(ON|OFF)}     { set sbc_built 1; exp_continue }
    -re {migrate *: *n/a}          { set sbc_built 0; exp_continue }
    -re {policy *: *(random|plru)} { set found_policy $expect_out(1,string); exp_continue }
    -re "$PROMPT"                  { }
    timeout                        { puts "\n(warning: sbc_read status read timed out)" }
}

if {$sbc_built == 1} {
    puts "===== Detected SBC hardware with policy: $found_policy"
} else {
    puts "===== NOTE: SBC status detected: $sbc_built, policy: $found_policy"
}

# ──────────────────────────────────────────────────────────────────────────────
# STEP 5: Run benchmarks with A/B migration evaluation
# ──────────────────────────────────────────────────────────────────────────────
puts "\n===== \[5/5\] Running benchmark evaluation ..."

board_cmd "cd /root/parsec"
expect -re "$PROMPT"

# List existing benchmark files on board
board_cmd "ls -la"
expect -re "$PROMPT"

# ─── BODYTRACK ───
# bodytrack requires input data (sequenceB_1 directory with images)
# simdev input: sequenceB_1 4 1 5 1 0 <nthreads>
puts "\n===== Running BODYTRACK ..."
set bt_cmd "./bodytrack sequenceB_1 4 1 5 1 0 $NTHREADS"

# Check if binary exists
board_cmd "test -x ./bodytrack && echo 'bodytrack_OK' || echo 'bodytrack_MISSING'"
expect {
    -re "bodytrack_OK" {
        expect -re "$PROMPT"
        # Phase 1: Migrate OFF (Baseline)
        if {![run_benchmark_phase "bodytrack (Phase 1: Migrate OFF)" $bt_cmd "off"]} {
            puts "!!! bodytrack Phase 1 (OFF) failed - continuing"
        }
        board_cmd "sleep 2"
        expect -re "$PROMPT"

        # Phase 2: Migrate ON (SBC Active)
        if {![run_benchmark_phase "bodytrack (Phase 2: Migrate ON)" $bt_cmd "on"]} {
            puts "!!! bodytrack Phase 2 (ON) failed - continuing"
        }
        board_cmd "sleep 2"
        expect -re "$PROMPT"
    }
    -re "bodytrack_MISSING" {
        expect -re "$PROMPT"
        puts "\n!!! WARNING: bodytrack binary not found on board. Skipping."
        lappend results [list "bodytrack" "off" "MISSING" "" ""]
        lappend results [list "bodytrack" "on"  "MISSING" "" ""]
    }
}

# ─── LU ───
puts "\n===== Running LU (SPLASH-2) ..."
set lu_cmd "./lu -p$NTHREADS -n512 -b16"

board_cmd "test -x ./lu && echo 'lu_OK' || echo 'lu_MISSING'"
expect {
    -re "lu_OK" {
        expect -re "$PROMPT"
        # Phase 1: Migrate OFF
        if {![run_benchmark_phase "lu (Phase 1: Migrate OFF)" $lu_cmd "off"]} {
            puts "!!! lu Phase 1 (OFF) failed - continuing"
        }
        board_cmd "sleep 2"
        expect -re "$PROMPT"

        # Phase 2: Migrate ON
        if {![run_benchmark_phase "lu (Phase 2: Migrate ON)" $lu_cmd "on"]} {
            puts "!!! lu Phase 2 (ON) failed - continuing"
        }
        board_cmd "sleep 2"
        expect -re "$PROMPT"
    }
    -re "lu_MISSING" {
        expect -re "$PROMPT"
        puts "\n!!! WARNING: lu binary not found on board. Skipping."
        lappend results [list "lu" "off" "MISSING" "" ""]
        lappend results [list "lu" "on"  "MISSING" "" ""]
    }
}

# ─── BARNES ───
puts "\n===== Running BARNES (SPLASH-2) ..."
set ba_cmd "./barnes < barnes_input"

board_cmd "test -x ./barnes && echo 'barnes_OK' || echo 'barnes_MISSING'"
expect {
    -re "barnes_OK" {
        expect -re "$PROMPT"
        # Phase 1: Migrate OFF
        if {![run_benchmark_phase "barnes (Phase 1: Migrate OFF)" $ba_cmd "off"]} {
            puts "!!! barnes Phase 1 (OFF) failed - continuing"
        }
        board_cmd "sleep 2"
        expect -re "$PROMPT"

        # Phase 2: Migrate ON
        if {![run_benchmark_phase "barnes (Phase 2: Migrate ON)" $ba_cmd "on"]} {
            puts "!!! barnes Phase 2 (ON) failed - continuing"
        }
        board_cmd "sleep 2"
        expect -re "$PROMPT"
    }
    -re "barnes_MISSING" {
        expect -re "$PROMPT"
        puts "\n!!! WARNING: barnes binary not found on board. Skipping."
        lappend results [list "barnes" "off" "MISSING" "" ""]
        lappend results [list "barnes" "on"  "MISSING" "" ""]
    }
}

# ──────────────────────────────────────────────────────────────────────────────
# Reset migrate to off
# ──────────────────────────────────────────────────────────────────────────────
board_cmd "cd /root"
expect -re "$PROMPT"
board_cmd "/root/sbc_read --migrate=off"
expect -re "$PROMPT"

# ──────────────────────────────────────────────────────────────────────────────
# FINAL REPORT
# ──────────────────────────────────────────────────────────────────────────────
puts "\n=================================================================="
puts "===== BENCHMARK EVALUATION RESULTS"
puts "=================================================================="
puts ""
puts [format "  %-20s %-10s %-10s %-15s" "BENCHMARK" "MIGRATE" "STATUS" "secondary_hits"]
puts [format "  %-20s %-10s %-10s %-15s" "─────────" "───────" "──────" "──────────────"]

foreach r $results {
    set rname  [lindex $r 0]
    set rmig   [lindex $r 1]
    set rstatus [lindex $r 2]
    set rsechits [lindex $r 3]

    set suitability ""
    if {$rstatus eq "OK"} {
        if {$rsechits eq "0" || $rsechits eq "?"} {
            set suitability "  << NOT SUITABLE (no secondary_hits)"
        } else {
            set suitability "  (workload active)"
        }
    }

    puts [format "  %-20s %-10s %-10s %-15s%s" $rname $rmig $rstatus $rsechits $suitability]
}

puts ""
puts "===== Transcript saved to: $LOGPATH"
puts "=================================================================="

# ──────────────────────────────────────────────────────────────────────────────
# Handover
# ──────────────────────────────────────────────────────────────────────────────
if {$DO_INTERACT} {
    puts "\n===== HANDING OVER TO INTERACTIVE SESSION (Ctrl-A Ctrl-X to exit)"
    interact
} else {
    send "\x01\x18"
    expect eof
    puts "\n>>> SERIAL PORT FREED <<<"
    puts "You can now run:"
    puts "    cd $SCRIPTS && ./connect_serial.sh"
}
exit 0
