# staging.exp - decide whether a file on the board is the file the host meant to put there.
#
# Shared by the ssbc session scripts. Canonical source: run_pair_session.exp / run_parsec_session.exp
# as of 2026-10-05.
#
# Requires these globals in the sourcing script:
#   HAVE_MD5    1 if the board has md5sum; probe it after login and set it
#   PUSH        always | verify | cache | none
#   BOARD_DIR   the board directory files are staged into
#   STAGED      host directory holding the staged workload files  (lib/config.exp)
# Requires from lib/board.exp: board_run, board_probe, bail
# Requires from lib/transfer.exp: zmodem_send
#
# Provides: board_matches  stage_file  stage_one

# Does the board's copy of a file match the host's, byte for byte? md5 where the board has it,
# a byte count where it does not.
#
# This is the check whose absence cost a whole session. On 2026-10-01 /mnt/sbc_read was present
# and executable but was not the sbc_read binary: an empty or non-ELF file execs as a silent
# shell script, so it printed nothing and exited 0. The script accepted it on "test -x" and all
# 72 runs of the sweep came back rc=0 with no counters and no workload - lu_ncb never ran at all
# (lu_session_20261001-204742.log). A size check alone would have caught that one, but not the
# case that worries us more here: a rebuilt binary is very often the same size as the build it
# replaces, so size says "same file" about a stale one. Hence md5 first.
proc board_matches {relname hostpath} {
    global HAVE_MD5
    if {$HAVE_MD5} {
        set want [lindex [exec md5sum $hostpath] 0]
        return [expr {[board_probe "test \"\$(md5sum $relname | cut -d' ' -f1)\" = $want" 300] == 0}]
    }
    set want [file size $hostpath]
    return [expr {[board_probe "test -f $relname && test \"\$(wc -c < $relname)\" -eq $want"] == 0}]
}

# Staging, in three modes (-push on the command line):
#
#   always  the default - every file this session needs comes down from the host, over zmodem,
#           every session. ~110s for the LU plan, ~12min for the whole PARSEC plan. It is the
#           only mode in which nothing on the board can be stale, and it is the default because
#           an hour of dead runs costs more than two minutes of transfers.
#   verify  keep what is already on the board when its md5 matches the host's, transfer when it
#           does not. As safe as "always", and as fast as the old cache, but it is a mode you
#           choose rather than one you get by accident.
#   none    -skippush: stage nothing. sbc_read is still md5-checked, because that is the one file
#           whose silent corruption costs a whole sweep, and a mismatch is fatal.
#
# The /mnt cache is no longer read in any mode. It is still written, because
# run_benchmarks_session.exp does trust it - writing a known-good copy repairs the entry that
# poisoned this one.
# One flat file from $STAGED into the current board directory, cached under /mnt/parsec.
proc stage_file {relname {is_exe 1}} {
    global STAGED
    stage_one $relname "$STAGED/$relname" "/mnt/parsec/$relname" $is_exe
}

proc stage_one {relname hostpath cachepath is_exe} {
    global PUSH BOARD_DIR
    if {![file exists $hostpath]} { bail "host file missing: $hostpath" }

    if {$PUSH eq "none"} { return }
    if {$PUSH eq "verify" && [board_matches $relname $hostpath]} {
        puts "---- $relname already on the board and matches the host"
        if {$is_exe} { board_run "chmod +x $relname" }
        return
    }
    # -push cache: an FPGA reprogram wipes the initramfs, so every ON window would otherwise pay
    # ~2.6 MB of zmodem at ~8.5 kB/s - about 28 minutes per boot, which dwarfs the measurement.
    # /mnt is the SD card and survives a reprogram, and stage_one has always written a copy there.
    # Reading it back is safe ONLY because the copy is md5-checked against the host first, then
    # md5-checked again after the local cp. That is the same guarantee -push verify gives, and it
    # is what the 2026-10-01 disaster lacked: back then a stale /mnt/sbc_read was accepted on a
    # bare "test -x", printed nothing, exited 0, and cost all 72 runs of a sweep.
    if {$PUSH eq "cache"} {
        if {[board_matches $relname $hostpath]} {
            puts "---- $relname already in $BOARD_DIR and matches the host"
            if {$is_exe} { board_run "chmod +x $relname" }
            return
        }
        if {[board_matches $cachepath $hostpath]} {
            puts "---- restoring $relname from the SD cache - no transfer needed"
            board_run "cp $cachepath $relname" 300
            if {![board_matches $relname $hostpath]} {
                bail "$relname copied from $cachepath does not match the host. The SD cache is\
corrupt; re-run with -push always to force a transfer."
            }
            if {$is_exe} { board_run "chmod +x $relname" }
            return
        }
        puts "---- $relname is not in the SD cache (or is stale) - transferring from the host"
    }

    board_run "rm -f $relname"
    zmodem_send $hostpath
    if {$is_exe} { board_run "chmod +x $relname" }
    # 300s, not the 60s default: this is an SD-card write of a file that can be megabytes, and
    # on 2026-10-05 the 245 KB netlist's cache write outlived the default timeout. Harmless when it
    # happens (the next board_cmd resyncs on its own echo) but it costs a minute each time.
    board_run "mkdir -p [file dirname $cachepath] ; cp $relname $cachepath 2>/dev/null || true" 300
}
