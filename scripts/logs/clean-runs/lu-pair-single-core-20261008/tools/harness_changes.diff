+# The LU-pair plan (copy only): ONE point, two lu_ncb at once on the one core.
+#   ./lu_ncb -p1 -nN -bA  and  ./lu_ncb -p1 -nN -bB  are both started in the background of the one measured sh -c;
+#   the shell waits for each by pid and echoes both exit codes; its own exit status is 0 only if both are 0.
+# Run to completion, not "until the first one finishes": the window closes when BOTH have exited, so each program
+# has done its whole job in the OFF and the ON arm (accessA is then comparable between the arms). With the b=32 and
+# b=128 solos at 22.6 s and 24.1 s alone, they overlap for almost the whole window.
+# Output files: a.out/a.err = the first block size, b.out/b.err = the second. The command stays free of single quotes
+# (it is wrapped in sh -c '...' by measure) and of anything but shell builtins besides the two lu_ncb, so the window
+# holds no extra exec. The trailing `2> wl.err` that measure appends lands on the last `test`.
+proc lupair_cmd {n ba bb} {
+    return "./lu_ncb -p1 -n$n -b$ba >a.out 2>a.err & PA=\$! ; ./lu_ncb -p1 -n$n -b$bb >b.out 2>b.err & PB=\$! ; wait \$PA ; RA=\$? ; wait \$PB ; RB=\$? ; echo PAIR-RC a=\$RA b=\$RB ; test \$RA -eq 0 && test \$RB -eq 0"
+}
+
+proc plan_lupair {} {
+    lassign $::PAIR_B ba bb
+    set label "lupair-p1-n${::PAIR_N}-b${ba}+b${bb}-$::POLICY"
+    return [list [point $label lu_ncb [lupair_cmd $::PAIR_N $ba $bb] lupair $::POLICY 1 $::PAIR_N "${ba}+${bb}"]]
+}
+
+# After a measured lupair window: print both reports. A separate command, so it is outside the counter window and the
+# measured command line stays short.
+proc post_window {pt} {
+    if {[dict get $pt axis] ne "lupair"} { return }
+    board_run "cat a.out b.out a.err b.err"
+}
+
 proc plan_for {which} {
     switch -- $which {
+        lupair  { return [plan_lupair] }
         lu      { return [plan_lu] }
         cal     { return [plan_cal] }
         sccal   { return [plan_sccal] }
